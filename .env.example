# Supabase Edge Functions 주소. 예: https://<project-ref>.supabase.co/functions/v1
# 클라이언트 번들에 들어가는 값이므로 비밀이 아닌 것만 둔다.
VITE_NAVER_MAP_KEY_ID=   # 네이버 클라우드 Maps Application의 Client ID. 정적 지도(raster-cors, Referer 인증)용. 번들에 들어간다.
VITE_API_BASE=

# 아래는 클라이언트가 아니라 Edge Function 환경변수다 (supabase secrets set).
# 절대 .env에 두지 않는다 — Vite가 VITE_ 접두사가 없는 값은 번들에 넣지 않지만,
# 파일 자체가 유출되면 끝이다.
#   SESSION_SIGNING_SECRET  세션 토큰 서명키 (openssl rand -base64 32)
#   TOSS_MTLS_CERT          앱인토스 mTLS 클라이언트 인증서 (PEM)
#   TOSS_MTLS_KEY           그 인증서의 개인키 (PEM)
#   TOSS_UNLINK_BASIC_AUTH  토스 연결 끊기 콜백 Basic Auth 비밀
#   NAVER_CLIENT_ID         네이버 클라우드 플랫폼 > AI·NAVER API > Application 의 Client ID (검색 API, 산 상세 "내려와서" 섹션)
#   NAVER_CLIENT_SECRET     같은 Application 의 Client Secret. 호출 헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
#   SHARELINK_ACCESS_KEY / SHARELINK_SECRET_KEY / SHARELINK_PUBLISHER_ID
#                           토스쇼핑 쉐어링크 오픈 API. 이 Mac에서 scripts/build-picks.mjs만 쓴다(출발지 IP 등록).

# 로컬 스크립트 전용 (Edge Function 아님). scripts/build-*.mjs가 .env에서 읽는다.
#   DATA_GO_KR_KEY          공공데이터포털 인증키 (숲나들e·봉우리POI·숲길POI·TourAPI 관광사진 공통)
