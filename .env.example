# Supabase Edge Functions 주소. 예: https://<project-ref>.supabase.co/functions/v1
# 클라이언트 번들에 들어가는 값이므로 비밀이 아닌 것만 둔다.
VITE_API_BASE=

# 아래는 클라이언트가 아니라 Edge Function 환경변수다 (supabase secrets set).
# 절대 .env에 두지 않는다 — Vite가 VITE_ 접두사가 없는 값은 번들에 넣지 않지만,
# 파일 자체가 유출되면 끝이다.
#   SESSION_SIGNING_SECRET  세션 토큰 서명키 (openssl rand -base64 32)
#   TOSS_MTLS_CERT          앱인토스 mTLS 클라이언트 인증서 (PEM)
#   TOSS_MTLS_KEY           그 인증서의 개인키 (PEM)
